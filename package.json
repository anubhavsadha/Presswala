{
  "name": "presswala",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aggregator app connecting Gurgaon households with their local presswalas.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:setup": "node scripts/migrate.mjs && node scripts/seed.mjs",
    "test": "node --test --experimental-strip-types --no-warnings tests/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "jose": "6.2.13",
    "next": "16.3.5",
    "postgres": "3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.2",
    "typescript": "^5"
  }
}
