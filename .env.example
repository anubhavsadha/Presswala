# Postgres connection string (Supabase, Neon, Railway, RDS or local)
DATABASE_URL=postgres://press:press@localhost:5432/presswala

# Long random string used to sign login sessions: `openssl rand -base64 32`
AUTH_SECRET=change-me-to-a-long-random-string

# Used by `npm run db:seed` to create the platform admin account
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=admin1234

# Set to 1 to also create demo areas' presswalas and customers when seeding
SEED_DEMO=1

# Protects /api/cron/schedules (Vercel Cron sends it as a Bearer token)
CRON_SECRET=change-me
